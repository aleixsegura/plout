# Copy to .env and fill in. One KEY=value per line; .env is gitignored.

# DEGIRO (export_degiro.py)
DEGIRO_USERNAME=
DEGIRO_PASSWORD=
# Optional: the account number; looked up when absent.
DEGIRO_INT_ACCOUNT=
# Optional: log in without the phone. Switch the account's 2FA to an
# authenticator app (DEGIRO → Settings → Security) and paste the text secret
# shown under the QR code here — and scan the QR in your authenticator too.
DEGIRO_TOTP_SECRET=

# export_revolut.py needs no keys — it drives the Revolut web app and prices
# crypto via Coinbase's public API.
